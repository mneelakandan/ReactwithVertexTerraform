# ── Backend (server.js) ────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=asia-south1     # or us-central1
PORT=3001                    # local dev port

# ── Frontend (React, prefix REACT_APP_) ───────────────────────────────────────
# For local dev, the React app talks to the local server
REACT_APP_API_BASE_URL=http://localhost:3001

# In production (Cloud Run), both frontend and backend are the same origin,
# so leave REACT_APP_API_BASE_URL empty or set it to your Cloud Run URL.
